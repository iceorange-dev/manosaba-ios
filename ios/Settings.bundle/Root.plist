<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>PreferenceSpecifiers</key>
	<array>
		<dict>
			<key>Type</key>
			<string>PSGroupSpecifier</string>
			<key>Title</key>
			<string>Graphics</string>
			<key>FooterText</key>
			<string>30 fps halves the work per second and keeps the phone cooler. Hold 30 fps when hot: from the thermal state Serious (and in Low Power Mode, whatever the switch) the frame rate is held at 30, as iOS slows the phone down then anyway; off, the setting stays and the phone runs warmer. Frame rate and MetalFX take effect when you return to the game; render resolution at the next launch, and only in games that support it. MetalFX sharpens the picture when it is scaled up to the screen. iOS always shows frames in step with the display, so there is no V-Sync switch.</string>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSMultiValueSpecifier</string>
			<key>Title</key>
			<string>Frame rate</string>
			<key>Key</key>
			<string>dm.fps</string>
			<key>DefaultValue</key>
			<integer>60</integer>
			<key>Titles</key>
			<array>
				<string>60 fps</string>
				<string>30 fps</string>
			</array>
			<key>Values</key>
			<array>
				<integer>60</integer>
				<integer>30</integer>
			</array>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSToggleSwitchSpecifier</string>
			<key>Title</key>
			<string>Hold 30 fps when hot</string>
			<key>Key</key>
			<string>dm.hot_hold</string>
			<key>DefaultValue</key>
			<true/>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSMultiValueSpecifier</string>
			<key>Title</key>
			<string>Render resolution</string>
			<key>Key</key>
			<string>dm.render_height</string>
			<key>DefaultValue</key>
			<integer>0</integer>
			<key>Titles</key>
			<array>
				<string>Game default</string>
				<string>Native (manosaba)</string>
				<string>900p</string>
				<string>720p</string>
				<string>540p</string>
			</array>
			<key>Values</key>
			<array>
				<integer>0</integer>
				<integer>-1</integer>
				<integer>900</integer>
				<integer>720</integer>
				<integer>540</integer>
			</array>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSToggleSwitchSpecifier</string>
			<key>Title</key>
			<string>MetalFX upscaling</string>
			<key>Key</key>
			<string>dm.metalfx</string>
			<key>DefaultValue</key>
			<false/>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSGroupSpecifier</string>
			<key>Title</key>
			<string>Touch Camera</string>
			<key>FooterText</key>
			<string>For games played with the on-screen controls: how fast a swipe on the right half turns the camera (1× is the default; a fast swipe turns at full speed whatever the setting), and which directions are reversed.</string>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSMultiValueSpecifier</string>
			<key>Title</key>
			<string>Sensitivity</string>
			<key>Key</key>
			<string>dm.look_sensitivity</string>
			<key>DefaultValue</key>
			<real>1</real>
			<key>Titles</key>
			<array>
				<string>0.25×</string>
				<string>0.5×</string>
				<string>0.75×</string>
				<string>1×</string>
				<string>1.25×</string>
				<string>1.5×</string>
				<string>2×</string>
				<string>2.5×</string>
				<string>3×</string>
			</array>
			<key>Values</key>
			<array>
				<real>0.25</real>
				<real>0.5</real>
				<real>0.75</real>
				<real>1</real>
				<real>1.25</real>
				<real>1.5</real>
				<real>2</real>
				<real>2.5</real>
				<real>3</real>
			</array>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSToggleSwitchSpecifier</string>
			<key>Title</key>
			<string>Invert Horizontal</string>
			<key>Key</key>
			<string>dm.look_invert_x</string>
			<key>DefaultValue</key>
			<false/>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSToggleSwitchSpecifier</string>
			<key>Title</key>
			<string>Invert Vertical</string>
			<key>Key</key>
			<string>dm.look_invert_y</string>
			<key>DefaultValue</key>
			<false/>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSGroupSpecifier</string>
			<key>Title</key>
			<string>On-screen Controls</string>
			<key>FooterText</key>
			<string>In the game, a three-finger tap (or the menu button between − and +) opens these settings; the controls' layout is edited there.</string>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSMultiValueSpecifier</string>
			<key>Key</key>
			<string>dm.touch_opacity</string>
			<key>Title</key>
			<string>Opacity</string>
			<key>DefaultValue</key>
			<real>1</real>
			<key>Titles</key>
			<array>
				<string>100 %</string>
				<string>75 %</string>
				<string>50 %</string>
				<string>30 %</string>
			</array>
			<key>Values</key>
			<array>
				<real>1</real>
				<real>0.75</real>
				<real>0.5</real>
				<real>0.3</real>
			</array>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSGroupSpecifier</string>
			<key>Title</key>
			<string>Diagnostics</string>
			<key>FooterText</key>
			<string>Shows the last lines of the app's log, or the game's frame rate, the frames reaching the screen and the GPU time per frame, over the game. Touches pass through them. To share the logs with the device's details, touch and hold the app's icon and choose Export Diagnostics.</string>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSToggleSwitchSpecifier</string>
			<key>Title</key>
			<string>Show frame rate</string>
			<key>Key</key>
			<string>dm.perf_line</string>
			<key>DefaultValue</key>
			<false/>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSToggleSwitchSpecifier</string>
			<key>Title</key>
			<string>Show log on screen</string>
			<key>Key</key>
			<string>dm.log_overlay</string>
			<key>DefaultValue</key>
			<false/>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSToggleSwitchSpecifier</string>
			<key>Title</key>
			<string>Only [red] lines</string>
			<key>Key</key>
			<string>dm.log_overlay_red</string>
			<key>DefaultValue</key>
			<false/>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSMultiValueSpecifier</string>
			<key>Title</key>
			<string>Lines</string>
			<key>Key</key>
			<string>dm.log_overlay_lines</string>
			<key>DefaultValue</key>
			<integer>14</integer>
			<key>Titles</key>
			<array>
				<string>8</string>
				<string>14</string>
				<string>24</string>
			</array>
			<key>Values</key>
			<array>
				<integer>8</integer>
				<integer>14</integer>
				<integer>24</integer>
			</array>
		</dict>
	</array>
</dict>
</plist>
